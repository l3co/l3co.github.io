---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
  /**
   * "feed" — whitespace-separated entry (title, excerpt, meta), no thumbnail.
   * "row" — single-line compact entry used in the dense /archives listing.
   * "compact" — small entry used in the home sidebar's "Destaques" list.
   */
  layout?: "feed" | "row" | "compact";
} & CollectionEntry<"post">;

const {
  variant: Heading = "h2",
  layout = "feed",
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, tags, ...props } = data;

const locale = Astro.currentLocale ?? config.site.lang;
const href = getPostUrl(id, filePath, locale);
const firstTag = tags?.[0];
---

{
  layout === "row" && (
    <li class="my-4">
      <a
        href={href}
        class:list={[
          "text-foreground hover:text-accent inline-block font-medium",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading
          transition:name={toTransitionName(id)}
          class="text-base sm:text-lg"
        >
          {title}
        </Heading>
      </a>
      <Datetime {...props} />
    </li>
  )
}

{
  layout === "compact" && (
    <li>
      <a href={href} class="link-title group">
        <Heading
          transition:name={toTransitionName(id)}
          class="link-title-text text-lg leading-snug font-semibold tracking-tight text-balance"
        >
          {title}
        </Heading>
        <p class="meta mt-1.5">
          <Datetime {...props} size="sm" class="meta-accent" />
        </p>
      </a>
    </li>
  )
}

{
  layout === "feed" && (
    <li>
      {firstTag && (
        <p class="meta mb-2">
          <a href={`/tags/${slugifyStr(firstTag)}/`} class="meta-accent hover:underline">
            {firstTag}
          </a>
        </p>
      )}
      <a href={href} class="link-title group">
        <Heading
          transition:name={toTransitionName(id)}
          class="link-title-text text-2xl leading-snug font-semibold tracking-tight text-balance sm:text-[1.75rem]"
        >
          {title}
        </Heading>
        <p class="text-muted-foreground mt-3 text-base leading-relaxed text-pretty">
          {description}
        </p>
        <p class="meta mt-4">
          <Datetime {...props} size="sm" class="meta-accent" />
        </p>
      </a>
    </li>
  )
}
