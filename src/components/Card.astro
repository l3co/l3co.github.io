---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";
import config from "@/config";

type Props = {
  variant?: "h2" | "h3";
  /**
   * "card" — thumbnail-forward card used in grids (home, /post, /tags/<tag>).
   * "row" — compact single-line entry used in dense lists (/archives).
   */
  layout?: "card" | "row";
} & CollectionEntry<"post">;

const {
  variant: Heading = "h2",
  layout = "card",
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, tags, ...props } = data;

const locale = Astro.currentLocale ?? config.site.lang;
const href = getPostUrl(id, filePath, locale);
const thumbnail = `${href.replace(/\/+$/, "")}/index.png`;
const firstTag = tags?.[0];
---

{
  layout === "row" ? (
    <li class="my-4">
      <a
        href={href}
        class:list={[
          "text-foreground hover:text-accent inline-block font-medium",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <Heading
          transition:name={toTransitionName(id)}
          class="text-base sm:text-lg"
        >
          {title}
        </Heading>
      </a>
      <Datetime {...props} />
    </li>
  ) : (
    <li class="surface-card group flex h-full flex-col">
      <a href={href} class="block aspect-16/9 overflow-hidden" tabindex="-1" aria-hidden="true">
        <img
          src={thumbnail}
          alt=""
          loading="lazy"
          width="1200"
          height="675"
          class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      </a>
      <div class="flex flex-1 flex-col gap-2 p-5">
        {firstTag && (
          <a
            href={`/tags/${slugifyStr(firstTag)}/`}
            class="text-accent w-fit text-xs font-bold tracking-wider uppercase hover:underline"
          >
            {firstTag}
          </a>
        )}
        <a href={href} class="focus-visible:no-underline">
          <Heading
            transition:name={toTransitionName(id)}
            class="hover:text-accent text-lg leading-snug font-bold text-balance"
          >
            {title}
          </Heading>
        </a>
        <p class="text-muted-foreground line-clamp-2 text-sm">{description}</p>
        <div class="mt-auto pt-2">
          <Datetime {...props} size="sm" />
        </div>
      </div>
    </li>
  )
}
