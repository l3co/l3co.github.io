---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["border-border border-t", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="app-layout grid gap-8 py-10 text-center sm:grid-cols-3 sm:items-center sm:text-left"
  >
    <div>
      <a href={getRelativeLocaleUrl(locale, "")} class="text-lg font-semibold tracking-tight">
        {config.site.title}
      </a>
      <p class="text-muted-foreground mt-1 text-xs">
        {t.footer.copyright} &#169; {currentYear}. {t.footer.allRightsReserved}
      </p>
    </div>

    <div class="flex justify-center">
      <Socials />
    </div>

    <p class="text-muted-foreground text-xs sm:text-right">
      Feito com{" "}
      <a
        href="https://astro.build/"
        target="_blank"
        rel="noreferrer"
        class="hover:text-accent underline decoration-dashed underline-offset-2"
      >
        Astro
      </a>
    </p>
  </div>
</footer>
