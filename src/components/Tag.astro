---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "border-border bg-muted/60 hover:bg-accent hover:text-accent-foreground hover:border-accent",
      "flex items-center gap-0.5 rounded-full border font-medium transition-colors",
      "focus-visible:bg-accent focus-visible:text-accent-foreground focus-visible:no-underline",
      { "px-2.5 py-1 text-sm": size === "sm" },
      { "px-3.5 py-1.5 text-base": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
