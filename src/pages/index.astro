---
import { getCollection, getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("post");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured).slice(0, 4);
const homePath = getRelativeLocaleUrl(locale, "");

const about = await getEntry("pages", "about");

// Most-used tags, for the sidebar's "Tags" widget — a lightweight stand-in
// for monograph's "Categories" (this blog only has one taxonomy: tags).
const tagCounts = new Map<string, { tagName: string; count: number }>();
for (const { data } of sortedPosts) {
  for (const tagName of data.tags) {
    const tag = slugifyStr(tagName);
    const entry = tagCounts.get(tag);
    if (entry) entry.count += 1;
    else tagCounts.set(tag, { tagName, count: 1 });
  }
}
const topTags = [...tagCounts.entries()]
  .map(([tag, value]) => ({ tag, ...value }))
  .sort((a, b) => b.count - a.count || a.tagName.localeCompare(b.tagName))
  .slice(0, 8);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b py-10 sm:py-16">
      <span class="eyebrow block">Seja bem-vindo(a)</span>
      <h1 class="mt-2 mb-3 inline-block text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl">
        Olá, eu sou o leco 👋
      </h1>
      <p class="text-muted-foreground max-w-2xl text-lg">
        Aqui eu compartilho o que vou aprendendo pelo caminho — tecnologia,
        desenvolvimento de software e fé. Fica à vontade pra ler, e se
        alguma coisa te fizer pensar (ou discordar 😄), deixa um
        comentário: adoro trocar ideia.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <LinkButton class="btn btn-solid" href={getRelativeLocaleUrl(locale, "post")}>
          {t.home.allPosts}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
        <LinkButton
          class="btn btn-outline"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          sobre mim
        </LinkButton>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="text-muted-foreground hover:text-accent inline-flex items-center gap-1"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss width={20} height={20} class="stroke-current stroke-3 rtl:-rotate-90" />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>
      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    <div class="grid gap-12 py-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,2fr)] lg:gap-12">
      <section aria-labelledby="recent-posts-heading">
        <h2 id="recent-posts-heading" class="section-title">{t.home.recentPosts}</h2>
        <ul class="feed">
          {sortedPosts.slice(0, postsConfig.perIndex).map(data => (
            <Card variant="h3" {...data} />
          ))}
        </ul>

        <LinkButton
          class="btn btn-outline mt-16 w-full justify-center"
          href={getRelativeLocaleUrl(locale, "post")}
        >
          {t.home.allPosts}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
      </section>

      <aside class="sidebar">
        <section aria-labelledby="about-heading">
          <h2 id="about-heading" class="section-title">{t.nav.about}</h2>
          <p class="text-lg font-semibold tracking-tight">{config.site.title}</p>
          {about && (
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed text-pretty">
              {about.data.description}
            </p>
          )}
          <LinkButton
            class="mt-3 text-sm font-medium"
            href={getRelativeLocaleUrl(locale, "about")}
          >
            {t.nav.about}
            <IconArrowRight class="inline-block size-3.5 rtl:-rotate-180" />
          </LinkButton>
        </section>

        {featuredPosts.length > 0 && (
          <section aria-labelledby="featured-heading">
            <h2 id="featured-heading" class="section-title">{t.home.featured}</h2>
            <ul class="grid gap-7">
              {featuredPosts.map(data => (
                <Card layout="compact" {...data} />
              ))}
            </ul>
          </section>
        )}

        {topTags.length > 0 && (
          <section aria-labelledby="tags-heading">
            <h2 id="tags-heading" class="section-title">{t.nav.tags}</h2>
            <ul class="grid gap-4">
              {topTags.map(({ tag, tagName, count }) => (
                <li>
                  <a
                    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
                    class="link-title group flex items-center justify-between gap-3"
                  >
                    <span class="link-title-text text-base font-semibold tracking-tight">
                      {tagName}
                    </span>
                    <span class="pill shrink-0">
                      {count} {count === 1 ? "post" : "posts"}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
