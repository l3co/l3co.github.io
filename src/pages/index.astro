---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("post");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b py-10 sm:py-16">
      <span class="eyebrow block">Seja bem-vindo(a)</span>
      <h1 class="mt-2 mb-3 inline-block text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl">
        Olá, eu sou o leco 👋
      </h1>
      <p class="text-muted-foreground max-w-2xl text-lg">
        Aqui eu compartilho o que vou aprendendo pelo caminho — tecnologia,
        desenvolvimento de software e fé. Fica à vontade pra ler, e se
        alguma coisa te fizer pensar (ou discordar 😄), deixa um
        comentário: adoro trocar ideia.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <LinkButton class="btn btn-solid" href={getRelativeLocaleUrl(locale, "post")}>
          {t.home.allPosts}
          <IconArrowRight class="inline-block rtl:-rotate-180" />
        </LinkButton>
        <LinkButton
          class="btn btn-outline"
          href={getRelativeLocaleUrl(locale, "about")}
        >
          sobre mim
        </LinkButton>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="text-muted-foreground hover:text-accent inline-flex items-center gap-1"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss width={20} height={20} class="stroke-current stroke-3 rtl:-rotate-90" />
          <span class="sr-only">RSS Feed</span>
        </a>
      </div>
      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-border border-b": recentPosts.length > 0 },
          ]}
        >
          <h2 class="section-title">{t.home.featured}</h2>
          <ul class="feed">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="section-title">{t.home.recentPosts}</h2>
          <ul class="feed">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-10 text-center">
      <LinkButton class="btn btn-outline" href={getRelativeLocaleUrl(locale, "post")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
